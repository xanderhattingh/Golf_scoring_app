# Copy this file to `.env.development` for local dev, or `.env` for production,
# and fill in the real values. Both files are git-ignored.

# URL of the Laravel API this frontend talks to
VITE_API_BASE_URL="http://127.0.0.1:8000/api/"

# API key for golfcourseapi.com — used by the "Import course from API" flow.
# Get one at https://golfcourseapi.com
VITE_GOLF_COURSE_API_KEY=""
